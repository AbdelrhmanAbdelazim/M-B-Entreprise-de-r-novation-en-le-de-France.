      ],
      "parameters": {
        "jsCode": "\nconst items = [\n  ['Assurance décennale Entoria', '2026-10-16'],\n  ['Campagne Meta Ads', '2026-10-19'],\n  ['Email Hostinger', '2026-11-07'],\n  ['Abonnement n8n', '2026-11-11'],\n  ['Domaine maison-mb.fr', '2027-02-13'],\n];\nconst today = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Paris' });\nconst reminderKey='reminder:'+today;\nif($('Rappels – Queue').all().some(i=>i.json.task_key===reminderKey))return [];\nconst lines = [];\nfor (const [name, date] of items) {\n  const d = Math.round((Date.parse(date) - Date.parse(today)) / 86400000);\n  if (![30, 7, 3, 1, 0].includes(d)) continue;\n  if (d === 0) lines.push(`🚨 النهارده آخر يوم: ${name} (${date}) — جدّد حالاً!`);\n  else if (d === 1) lines.push(`⚠️ بكرة آخر يوم: ${name} (${date})`);\n  else lines.push(`⏰ فاضل ${d} يوم على: ${name} (${date})`);\n}\n\n// --- Claude API : pas d'endpoint de solde → rappel tous les 15 jours (à partir du 19/10/2026)\nconst jours = Math.round((Date.parse(today) - Date.parse('2026-10-19')) / 86400000);\nif (jours >= 0 && jours % 15 === 0) lines.push('💳 افتكر تشوف رصيد Claude API (console.anthropic.com ← Billing). لو أقل من 3 $ اشحن الرصيد.');\n// --- Oxylabs AI : pas d'endpoint de solde → estimation = crédits de départ − consommation notée par W7 dans le journal\nconst OXYLABS_DEPART = 1000, SEUIL = 200;\nconst rows = $('Journal').all().map(i => i.json).filter(r => r.workflow === 'W7');\nconst used = (filtre) => rows.filter(filtre).reduce((s, r) => s + Number((String(r.details || '').match(/oxylabs_credits=(\\d+)/) || [0, 0])[1]), 0);\nconst reste = OXYLABS_DEPART - used(() => true);\nconst resteHier = OXYLABS_DEPART - used(r => String(r.date || '').slice(0, 10) < today);\nconst lundi = new Date(today + 'T12:00:00Z').getUTCDay() === 1;\nif (reste < SEUIL && (resteHier >= SEUIL || lundi)) lines.push(`🔋 رصيد Oxylabs قرب يخلص: فاضل حوالي ${reste} credit من ${OXYLABS_DEPART} (تقدير). اشحن من hPanel أو قلّل البحث في W7.`);\nfor(const it of $('Rappels – Queue').all()){const r=it.json;if(r.type!=='deadline'||['done','rejected'].includes(r.status))continue;const due=String(r.due_at||'').slice(0,10);const delta=Math.round((Date.parse(due)-Date.parse(today))/86400000);if([1,0].includes(delta))lines.push((delta===1?'⏰ بكرة: ':'⚠️ اليوم: ')+r.next_action+' (#'+r.id+')');}\nif (!lines.length) return [];\nreturn [{ json: { message: '🔔 تذكير M&B\\n\\n' + lines.join('\\n'), _reservation:{task_key:reminderKey,type:'action',priority:'WARM',source:'W6',owner:'W6',status:'reserved',created_at:new Date().toISOString(),last_action:new Date().toISOString(),next_action:'Livraison du rappel réservée ; vérifier les logs avant toute répétition',due_at:today,payload:JSON.stringify({kind:'management_reminder',execution:$execution.id})} } }];\n"
      }
    },
